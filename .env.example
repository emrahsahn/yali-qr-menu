# Yalı Restaurant Görevli Paneli Güvenlik Ayarları
# ŞİFRELERİ ASLA GİT'E COMMIT ETMEYİN — sadece .env.local'da tutun.
STAFF_USERNAME=yali_yonetim
STAFF_PASSWORD=your_secure_password_here
AUTH_SECRET=your_secret_signing_key_here

# Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase (opsiyonel — set edilmezse sistem Redis/dosya tabanlı çalışır)
# NEXT_PUBLIC_SUPABASE_URL: Project URL (Supabase Dashboard > Settings > API)
# SUPABASE_SERVICE_ROLE_KEY: service_role key — SUNUCU TARAFINDAN kullanılır,
#   RLS'i atlar ve asla tarayıcıya açılmaz. Deploy ortamında set edilmezse
#   masa/sepet/sipariş API rotaları 503 döner.
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Upstash Redis (opsiyonel — menü verisi kalıcı saklama)
KV_REST_API_URL=
KV_REST_API_TOKEN=
